# Template dasar environment. Untuk development, pakai `.env.development.local`.
# Untuk production, pakai environment variable di host deployment atau `.env.production.local`.
#
# Next.js akan membaca file berdasarkan mode:
# - development: `.env.development.local` -> `.env.development` -> `.env.local` -> `.env`
# - production: `.env.production.local` -> `.env.production` -> `.env.local` -> `.env`
#
# Prisma memakai `POSTGRES_PRISMA_URL` untuk runtime dan `POSTGRES_URL_NON_POOLING`
# untuk migration / direct connection.
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
