# Copy this file to `.env.development.local` for local development.
# This template assumes PostgreSQL berjalan di localhost.

POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/sismata?sslmode=disable"
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/sismata?sslmode=disable"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/sismata?sslmode=disable"
POSTGRES_USER="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PASSWORD="postgres"
AUTH_SECRET="change-me-local-dev-secret"
AUTH_TRUST_HOST="true"
APP_ENV="development"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="organization-assets"
