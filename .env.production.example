# Copy this file to `.env.production.local` on production hosts if you do not
# inject environment variables directly from the platform.
# Untuk deployment Vercel, isi env runtime yang sama di Project Settings.
# Untuk workflow GitHub Actions `Migrate Production`, replikasi minimal
# POSTGRES_PRISMA_URL dan POSTGRES_URL_NON_POOLING ke GitHub Environment
# `production` agar migration mengarah ke database yang sama dengan runtime.

POSTGRES_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
POSTGRES_URL_NON_POOLING="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require"
POSTGRES_USER="postgres"
POSTGRES_HOST="db.project-ref.supabase.co"
POSTGRES_PASSWORD="password"
AUTH_SECRET="replace-with-long-random-secret"
AUTH_TRUST_HOST="true"
APP_ENV="production"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="organization-assets"
